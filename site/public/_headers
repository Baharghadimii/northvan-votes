# Cloudflare Pages headers.
#
# The site has no accounts, no forms, no analytics and no third-party requests,
# so the policy below can be tight. script-src keeps 'unsafe-inline' because the
# countdown, the candidate shuffle and the ballot list are small inline scripts
# rather than bundled modules; everything else is locked down.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Self-hosted fonts never change without a filename change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Content-addressed by Astro, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photos are named by candidate id and only change if a municipality replaces
# one, which is rare and handled by a redeploy.
/photos/*
  Cache-Control: public, max-age=604800

# Pages change as candidates are re-tagged or voting details are corrected.
# Short cache, revalidate often — a stale voting location is the one thing this
# site must never serve.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
