---
import { ADVANCE_OPENS, POLLS_OPEN, POLLS_CLOSE } from "~/lib/election";
import { VOTING } from "~/lib/voting";

// Advance voting is not every day, and the two municipalities do not share a
// schedule: the City opens on five days, the District on three, and on four of
// the days in between neither is open. Saying "advance voting is open now" for
// the whole window would send someone to a locked door, so the strip reads the
// same table the voting page prints.
const ADVANCE = {
  cnv: VOTING.cnv.advance.map((d) => ({ iso: d.iso, label: d.date })),
  dnv: VOTING.dnv.advance.map((d) => ({ iso: d.iso, label: d.date })),
};

interface Props {
  /** "bar" is the thin header strip; "hero" is the large homepage block. */
  variant?: "bar" | "hero";
}
const { variant = "bar" } = Astro.props;
const id = `cd-${Math.random().toString(36).slice(2, 9)}`;
---

<div class={variant === "hero" ? "countdown-hero" : "countdown-inline"} id={id} data-countdown>
  <span class="cd-label" data-cd-label>Election day is Saturday, October 17, 2026.</span>
  {variant === "hero" && (
    <div class="cd-clock" data-cd-clock hidden>
      <div class="cd-unit"><b data-cd-d>–</b><span>days</span></div>
      <div class="cd-unit"><b data-cd-h>–</b><span>hours</span></div>
      <div class="cd-unit"><b data-cd-m>–</b><span>minutes</span></div>
      <div class="cd-unit"><b data-cd-s>–</b><span>seconds</span></div>
    </div>
  )}
  {variant === "bar" && <span class="cd-compact" data-cd-compact></span>}
  <span class="cd-sub" data-cd-sub></span>
</div>

<script is:inline define:vars={{ id, ADVANCE_OPENS, POLLS_OPEN, POLLS_CLOSE, ADVANCE }}>
  (function () {
    var root = document.getElementById(id);
    if (!root) return;

    var advance = Date.parse(ADVANCE_OPENS);
    var open = Date.parse(POLLS_OPEN);
    var close = Date.parse(POLLS_CLOSE);

    var label = root.querySelector("[data-cd-label]");
    var sub = root.querySelector("[data-cd-sub]");
    var compact = root.querySelector("[data-cd-compact]");
    var clock = root.querySelector("[data-cd-clock]");
    var d = root.querySelector("[data-cd-d]");
    var h = root.querySelector("[data-cd-h]");
    var m = root.querySelector("[data-cd-m]");
    var s = root.querySelector("[data-cd-s]");

    function plural(n, word) { return n + " " + word + (n === 1 ? "" : "s"); }

    // Today where the election is, not where the reader is.
    function localToday() {
      var p = new Intl.DateTimeFormat("en-CA", {
        timeZone: "America/Vancouver",
        year: "numeric", month: "2-digit", day: "2-digit",
      }).format(new Date());
      return p; // en-CA formats as YYYY-MM-DD
    }

    function nextAfter(list, today) {
      for (var i = 0; i < list.length; i++) {
        if (list[i].iso > today) return list[i];
      }
      return null;
    }

    function advanceToday() {
      var today = localToday();
      var openNow = [];
      if (ADVANCE.cnv.some(function (x) { return x.iso === today; })) openNow.push("the City");
      if (ADVANCE.dnv.some(function (x) { return x.iso === today; })) openNow.push("the District");

      if (openNow.length === 2) {
        return "Advance voting is open today in both the City and the District.";
      }
      if (openNow.length === 1) {
        var other = openNow[0] === "the City" ? ADVANCE.dnv : ADVANCE.cnv;
        var otherName = openNow[0] === "the City" ? "the District" : "the City";
        var nxt = nextAfter(other, today);
        return "Advance voting is open today in " + openNow[0] + " only. " +
          (nxt ? otherName.charAt(0).toUpperCase() + otherName.slice(1) + " next opens " + nxt.label + "."
               : "Advance voting has finished in " + otherName + ".");
      }
      var nc = nextAfter(ADVANCE.cnv, today);
      var nd = nextAfter(ADVANCE.dnv, today);
      if (!nc && !nd) return "Advance voting has finished. General voting day is Saturday, October 17.";
      if (nc && nd && nc.iso === nd.iso) return "No advance voting today. Both reopen " + nc.label + ".";
      // Soonest first: whoever opens next is the useful half of the sentence.
      var up = [];
      if (nc) up.push({ iso: nc.iso, text: "the City on " + nc.label });
      if (nd) up.push({ iso: nd.iso, text: "the District on " + nd.label });
      up.sort(function (a, b) { return a.iso < b.iso ? -1 : 1; });
      return "No advance voting today. Next: " + up.map(function (x) { return x.text; }).join(", ") + ".";
    }

    function phase(now) {
      // Each phase answers a different question, so the copy changes with it
      // rather than counting down to one fixed instant all month.
      if (now < advance) {
        return { target: advance, lead: "Advance voting opens in",
                 sub: "General voting day is Saturday, October 17." };
      }
      if (now < open) {
        return { target: open, lead: "General voting day in", sub: advanceToday() };
      }
      if (now < close) {
        return { target: close, lead: "Polls close in",
                 sub: "Voting places are open until 8:00 p.m." };
      }
      return { target: null, lead: "Voting has closed.",
               sub: "Results are published by each municipality." };
    }

    function tick() {
      var now = Date.now();
      var p = phase(now);

      if (p.target === null) {
        if (label) label.textContent = p.lead;
        if (compact) compact.textContent = "";
        if (clock) clock.hidden = true;
        if (sub) sub.textContent = p.sub;
        return;
      }

      var left = Math.max(0, p.target - now);
      var secs = Math.floor(left / 1000);
      var days = Math.floor(secs / 86400);
      var hours = Math.floor((secs % 86400) / 3600);
      var mins = Math.floor((secs % 3600) / 60);
      var rem = secs % 60;

      if (clock) {
        clock.hidden = false;
        if (label) label.textContent = p.lead;
        if (d) d.textContent = String(days);
        if (h) h.textContent = String(hours).padStart(2, "0");
        if (m) m.textContent = String(mins).padStart(2, "0");
        if (s) s.textContent = String(rem).padStart(2, "0");
      } else if (compact) {
        if (label) label.textContent = p.lead + " ";
        compact.textContent =
          days > 0 ? plural(days, "day") + ", " + plural(hours, "hour")
          : hours > 0 ? plural(hours, "hour") + ", " + plural(mins, "minute")
          : plural(mins, "minute") + ", " + plural(rem, "second");
      }
      if (sub) sub.textContent = p.sub;
    }

    tick();
    // A seconds display needs a second; the header strip does not.
    setInterval(tick, clock ? 1000 : 30000);
  })();
</script>
