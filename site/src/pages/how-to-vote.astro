---
import Base from "~/layouts/Base.astro";
import { VOTING, VERIFIED } from "~/lib/voting";
import { formatDate, races } from "~/lib/data";
import { RESULTS_SOURCES, electedIn } from "~/lib/results";

// The election is over. This page used to tell people when, where and how to
// vote; it now keeps that as a record, in the past tense, and points at the
// official results. The URL stays the same so old links still land here.
const munis = ["cnv", "dnv"] as const;
const allRaces = races();
---

<Base
  title="How the vote worked"
  description="How the October 17, 2026 North Vancouver election worked: two municipalities, two ballots, how many people each voter could choose, and where the official results are."
>
  <h1>How the October 17 vote worked</h1>
  <p class="lede">
    North Vancouver is two separate municipalities, and each held its own
    election with its own ballot. Voting closed at 8:00 p.m. on Saturday,
    October 17, 2026, and{" "}<a href="/#results">both have declared their
    official results</a>.
  </p>

  <h2>Two municipalities, two ballots</h2>
  <p>
    The City and the District are different local governments, each with its
    own mayor and council. Each voter voted in exactly one: whichever they lived
    in, or, for someone who owned property here without living here, whichever
    the property was in.
  </p>
  <ul>
    <li>
      <strong>City of North Vancouver</strong> — the smaller, denser area around
      Lonsdale and the waterfront, roughly between the Capilano River and Lynn
      Creek south of about 29th Street.
    </li>
    <li>
      <strong>District of North Vancouver</strong> — the larger area wrapping
      around it: Lynn Valley, Deep Cove, Edgemont, Capilano Highlands, Seymour,
      Parkgate, Blueridge and the North Shore mountains.
    </li>
  </ul>
  <p>
    Not sure which council represents you? Your property tax or utility bill
    names the municipality that issued it.
  </p>

  <h2>How the ballot worked</h2>
  <p>
    Each voter could mark as many names as there were seats, not one. Council
    elected six, so voters could mark up to six names, and the six with the most
    votes won. Marking fewer was allowed. Marking more than the number of seats
    meant that part of the ballot could not be counted.
  </p>
  <p>
    School trustees for School District 44 were elected by voters in both
    municipalities, but on separate ballots with different candidates.
  </p>

  <h2>What was on each ballot</h2>
  <div class="grid grid-2" style="margin-top:12px">
    {munis.map((m) => {
      const src = RESULTS_SOURCES[m];
      return (
        <div class="card">
          <h3 style="margin-top:0">{src.name}</h3>
          <ul style="margin:0; padding-left:18px">
            {allRaces.filter((r) => r.municipality === m).map((r) => (
              <li style="margin-bottom:6px">
                <a href={`/candidates/#${r.key}`}>{r.label.split(" — ")[1]}</a>:
                {" "}{r.candidates.length} ran for {r.seats === 1 ? "1 seat" : `${r.seats} seats`}.
                {" "}<span class="candidate-meta">
                  Elected: {electedIn(r.candidates).map((c) => c.name).join(", ")}.
                </span>
              </li>
            ))}
          </ul>
          <p class="candidate-meta" style="margin:10px 0 0">
            Source:{" "}<a href={src.url} target="_blank" rel="noopener">{src.label}</a>,
            declared {src.declared}.
          </p>
        </div>
      );
    })}
  </div>

  <h2 style="margin-top:38px">When and where people voted</h2>
  <p>
    Kept as a record. These are the dates and places each municipality
    published before the election.
  </p>

  {munis.map((key) => {
    const m = VOTING[key];
    return (
      <details class="silent" style="margin-top:12px">
        <summary>{m.name}: advance voting and general voting day</summary>

        <h3 style="margin-top:14px">Advance voting</h3>
        <ul style="padding-left:18px; font-size:0.92rem">
          {m.advance.map((day) => (
            <li style="margin-bottom:5px">
              <strong>{day.date}</strong>, {day.hours}:{" "}
              {day.places.map((p) => `${p.name}, ${p.address}`).join("; ")}
            </li>
          ))}
        </ul>

        <h3 style="margin-top:14px">General voting day, Saturday, October 17</h3>
        <p class="candidate-meta">Open {m.generalDay.hours}, at any of these places.</p>
        <ul class="voting-places">
          {m.generalDay.places.map((p) => (
            <li>
              {p.name}<br />
              <span style="color:var(--text-faint)">{p.address}</span>
            </li>
          ))}
        </ul>

        {m.special && <p class="candidate-meta">{m.special}</p>}

        <p style="font-size:0.85rem; color:var(--text-faint)">
          Source:{" "}<a href={m.source} target="_blank" rel="noopener">{m.name} election page</a>,
          last checked {formatDate(VERIFIED)}.
        </p>
      </details>
    );
  })}
</Base>
