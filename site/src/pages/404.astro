---
import Base from "~/layouts/Base.astro";
import { categoriesByCoverage, candidates } from "~/lib/data";
const top = categoriesByCoverage().slice(0, 6);
---
<Base title="Page not found" description="That page doesn't exist on North Van Votes.">
  <h1>That page isn't here</h1>
  <p class="lede">
    The link may be old, or mistyped. Everything on the site is one of these:
  </p>
  <ul class="linklist" style="margin:18px 0 26px">
    <li><a class="tag" href="/" style="text-decoration:none">All issues</a></li>
    <li><a class="tag" href="/candidates/" style="text-decoration:none">All {candidates.length} candidates</a></li>
    <li><a class="tag" href="/compare/" style="text-decoration:none">Compare</a></li>
    <li><a class="tag" href="/how-to-vote/" style="text-decoration:none">How to vote</a></li>
  </ul>
  <h2>Most-discussed issues</h2>
  <div class="grid grid-2 grid-3" style="margin-top:14px">
    {top.map((c) => (
      <a class="card issue-card" href={`/issues/${c.id}/`} style={`--cat-hue:${c.hue}`}>
        <h3>{c.label}</h3>
        <div class="count">{c.count} of {candidates.length} candidates</div>
      </a>
    ))}
  </div>
</Base>
