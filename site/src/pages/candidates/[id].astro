---
import Base from "~/layouts/Base.astro";
import Avatar from "~/components/Avatar.astro";
import Quote from "~/components/Quote.astro";
import {
  candidates, categories, backgroundKinds, MUNICIPALITIES, OFFICES, SEATS,
  formatDate, UNREADABLE_SITES, type Candidate,
} from "~/lib/data";

export function getStaticPaths() {
  return candidates.map((c) => ({ params: { id: c.id }, props: { candidate: c } }));
}

const { candidate } = Astro.props as { candidate: Candidate };

const byCategory = categories
  .map((cat) => ({
    cat,
    positions: candidate.positions.filter((p) => p.category === cat.id),
  }))
  .filter((g) => g.positions.length > 0);

const untouched = categories.filter(
  (cat) => !candidate.positions.some((p) => p.category === cat.id),
);

// Grouped in the order declared in the taxonomy: office first, then career,
// education, community, roots.
const byBackground = backgroundKinds
  .map((kind) => ({
    kind,
    entries: candidate.background.filter((b) => b.category === kind.id),
  }))
  .filter((g) => g.entries.length > 0);

const seats = SEATS[`${candidate.municipality}-${candidate.office}`];
const statement = candidate.sources.find((s) => s.type === "official_statement");
const socialOrder = ["website", "facebook_campaign", "facebook", "instagram", "twitter", "linkedin", "youtube", "bluesky", "threads", "tiktok"];
const socials = Object.entries(candidate.socials).sort(
  (a, b) => socialOrder.indexOf(a[0]) - socialOrder.indexOf(b[0]),
);
const SOCIAL_LABELS: Record<string, string> = {
  facebook_campaign: "Campaign Facebook page",
  facebook: "Facebook", instagram: "Instagram", twitter: "X", linkedin: "LinkedIn",
  youtube: "YouTube", bluesky: "Bluesky", threads: "Threads", tiktok: "TikTok",
};
---

<Base
  title={candidate.name}
  description={`${candidate.name}, candidate for ${OFFICES[candidate.office]} in the ${MUNICIPALITIES[candidate.municipality]}, 2026.`}
>
  <p style="font-size:0.88rem"><a href="/candidates/">← All candidates</a></p>

  <div class="candidate-row" style="align-items:center; gap:18px; margin-bottom:6px">
    <Avatar candidate={candidate} />
    <div>
      <h1 style="margin-bottom:2px">{candidate.name}</h1>
      <p style="margin:0; color:var(--text-muted)">
        {OFFICES[candidate.office]} candidate · {MUNICIPALITIES[candidate.municipality]}
        {candidate.incumbent && <span class="tag tag-incumbent" style="margin-left:8px">Incumbent</span>}
      </p>
    </div>
  </div>

  <p style="color:var(--text-faint); font-size:0.88rem">
    {seats === 1
      ? "One is elected to this office."
      : `${seats} are elected to this office.`}
  </p>

  <ul class="linklist" style="margin:16px 0 24px">
    {candidate.website && <li><a href={candidate.website} rel="noopener nofollow">Campaign website</a></li>}
    {candidate.email && <li><a href={`mailto:${candidate.email}`}>{candidate.email}</a></li>}
    {candidate.phone && <li>{candidate.phone}</li>}
    {socials.map(([k, url]) => (
      <li><a href={url} rel="noopener nofollow">{SOCIAL_LABELS[k] ?? k}</a></li>
    ))}
    {candidate.nomination_docs.map((d) => (
      <li><a href={d} rel="noopener">Nomination documents</a></li>
    ))}
    {candidate.financial_disclosure.map((d) => (
      <li><a href={d} rel="noopener">Financial disclosure</a></li>
    ))}
  </ul>

  {byBackground.length > 0 && (
    <section style="margin-bottom:30px">
      <h2>Background</h2>
      <p style="font-size:0.85rem; color:var(--text-faint); margin-bottom:14px">
        What they say they've done, in their own words. I haven't checked any of
        it, and neither did the municipality that published it.
      </p>
      <div class="bg-grid">
        {byBackground.map((g) => (
          <div class="bg-item">
            <h3>{g.kind.label}</h3>
            {g.entries.map((b) => <Quote candidate={candidate} position={b} />)}
          </div>
        ))}
      </div>
    </section>
  )}

  {UNREADABLE_SITES[candidate.id] && !candidate.sources.some((s) => s.type === "campaign_site") && (
    <div class="notice">
      <p>
        <strong>There's less here than for some other candidates, and that's on
        me.</strong> {UNREADABLE_SITES[candidate.id]} What's below comes from
        their filed statement alone. Their own site is linked above.
      </p>
    </div>
  )}

  <h2>Where they stand</h2>
  {byCategory.length === 0 ? (
    <div class="notice">
      <p>
        {statement
          ? "They filed a statement, but it doesn't take a position on any issue I track. It's below in full, and their background is above if they gave one."
          : "They haven't filed a statement with either municipality, and I couldn't find a campaign website."}
      </p>
    </div>
  ) : (
    byCategory.map((g) => (
      <section style="margin-bottom:22px">
        <h3 style="margin-bottom:2px">
          <a href={`/issues/${g.cat.id}/`} style="text-decoration:none">{g.cat.label}</a>
        </h3>
        {g.positions.map((p) => <Quote candidate={candidate} position={p} />)}
      </section>
    ))
  )}

  {untouched.length > 0 && byCategory.length > 0 && (
    <details class="silent">
      <summary>Topics not covered in the sources we checked ({untouched.length})</summary>
      <ul>
        {untouched.map((c) => (
          <li><a href={`/issues/${c.id}/`}>{c.label}</a></li>
        ))}
      </ul>
    </details>
  )}

  {statement && (
    <section style="margin-top:34px">
      <h2>Full statement, as published</h2>
      <p style="font-size:0.85rem; color:var(--text-faint)">
        Reproduced exactly as it appears on the
        <a href={statement.url} rel="noopener"> {MUNICIPALITIES[candidate.municipality]} website</a>,
        retrieved {formatDate(statement.retrieved)}. Neither the municipality nor
        this site has verified its accuracy.
      </p>
      <div class="card" style="font-family:var(--font-serif)">
        {statement.text.split(/\n{2,}/).map((p) => <p>{p}</p>)}
      </div>
    </section>
  )}
</Base>
