---
import Base from "~/layouts/Base.astro";
import CandidateLine from "~/components/CandidateLine.astro";
import { races, candidates, seededShuffle, BUILD_SEED, categoryById, categoriesByCoverage } from "~/lib/data";

const filterable = categoriesByCoverage().filter((c) => c.count > 0);

const allRaces = races();
---

<Base
  title="All candidates"
  description="Every candidate for mayor, council and school trustee in the City and District of North Vancouver, October 17, 2026."
  shuffle
  shortlist
>
  <h1>All {candidates.length} candidates</h1>
  <p class="lede">
    You vote in one municipality only, the City or the District, never both.
    {" "}<a href="/how-to-vote/">Not sure which?</a>
  </p>

  <div class="name-search">
    <label for="name-search">Looking for someone in particular?</label>
    <div class="name-search-row">
      <input
        id="name-search"
        type="search"
        data-name-search
        placeholder="Type a name"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" data-name-clear hidden>Clear</button>
    </div>
  </div>

  <div class="issue-filter" data-issue-filter>
    <span class="issue-filter-label">Show only candidates who've addressed:</span>
    <div class="chip-row">
      <button type="button" class="chip chip-on" data-issue="" aria-pressed="true">Everyone</button>
      {filterable.map((c) => (
        <button type="button" class="chip" data-issue={c.id} aria-pressed="false">
          {c.label} <em>{c.count}</em>
        </button>
      ))}
    </div>
    <p class="issue-filter-count" data-filter-count hidden></p>
  </div>

  <div class="order-note">
    <span>Listed in <span data-order-label>randomised</span> order within each race.</span>
    <button type="button" data-order-toggle hidden>Sort A–Z</button>
  </div>

  {allRaces.map((race) => (
    <section id={race.key}>
      <div class="race-heading">
        <h2>{race.label}</h2>
        <span class="seats">{race.candidates.length} running · you elect {race.seats}</span>
      </div>
      <div class="grid grid-2" data-shuffle style="margin-top:14px">
        {seededShuffle(race.candidates, BUILD_SEED + race.key.length).map((c) => {
          const topics = [...new Set(c.positions.map((p) => p.category))];
          return (
            <div class="card card-link" data-sortkey={c.surname + " " + c.name} data-topics={[...new Set(c.positions.map((p) => p.category))].join(" ")}>
              <CandidateLine candidate={c}>
                <div style="margin-top:8px; display:flex; flex-wrap:wrap; gap:5px">
                  {topics.length > 0 ? (
                    topics.map((t) => <span class="tag">{categoryById(t)?.label ?? t}</span>)
                  ) : c.sources.length > 0 ? (
                    <span class="tag">Statement has no issue positions</span>
                  ) : (
                    <span class="tag">No statement published</span>
                  )}
                </div>
              </CandidateLine>
            </div>
          );
        })}
      </div>
    </section>
  ))}
</Base>
