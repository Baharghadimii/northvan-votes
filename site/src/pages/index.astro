---
import Base from "~/layouts/Base.astro";
import Countdown from "~/components/Countdown.astro";
import FaceWall from "~/components/FaceWall.astro";
import { categoriesByCoverage, candidates, races, flashpoints } from "~/lib/data";

const cats = categoriesByCoverage();
const withStatement = candidates.filter((c) => c.sources.length > 0).length;
const tagged = candidates.filter((c) => c.positions.length > 0).length;
const allRaces = races();
---

<Base
  title="North Van Votes"
  description="What all 59 candidates in the October 17 North Vancouver election have actually said, sorted by issue. Their words, with links to the source."
  ownCountdown
>
  <h1>59 people want your vote on October 17.</h1>
  <p class="lede">
    I couldn't find a straight answer on where any of them stood, so I built
    this. Pick something you care about. Traffic, housing, schools. Then read
    what each candidate actually said about it. Their words, not mine, with a
    link to where they said it.
  </p>

  <FaceWall />
  <p class="facewall-caption">
    All 59 of them. Hover a face, or{" "}<a href="/candidates/">see the whole list</a>.
  </p>

  <Countdown variant="hero" />

  <div class="stat-row">
    <div class="stat"><b>{candidates.length}</b><span>running across two municipalities</span></div>
    <div class="stat"><b>{withStatement}</b><span>filed a written statement</span></div>
    <div class="stat"><b>{tagged}</b><span>said something I could quote</span></div>
  </div>

  <h2 id="issues" style="margin-top:32px">What are they actually talking about?</h2>
  <p style="color:var(--text-muted); font-size:0.94rem; max-width:44rem">
    The number under each topic is how many of the 59 I found saying something
    about it. A low number means most of them didn't write about it. It doesn't
    mean it isn't worth caring about.
  </p>

  <div class="grid grid-2 grid-3" style="margin-top:18px">
    {cats.map((c) => (
      <a class="card issue-card" href={`/issues/${c.id}/`} style={`--cat-hue:${c.hue}`}>
        <h3>{c.label}</h3>
        <p>{c.description}</p>
        <div class="count">
          {c.count === 0
            ? "No candidate has addressed this"
            : `${c.count} of ${candidates.length} candidates`}
        </div>
      </a>
    ))}
  </div>

  <h2 style="margin-top:44px">The specific fights</h2>
  <p style="color:var(--text-muted); font-size:0.94rem; max-width:44rem">
    Named things people here actually argue about, rather than broad topics.
    These pick up candidates who used the words.
  </p>
  <ul class="linklist" style="margin-top:14px">
    {flashpoints.map((f) => {
      const n = candidates.filter((c) =>
        [...c.positions, ...c.background].some((p) => p.flashpoints.includes(f.id)),
      ).length;
      return n > 0 ? (
        <li>
          <a class="tag" href={`/flashpoints/${f.id}/`} style="text-decoration:none">
            {f.label} — {n}
          </a>
        </li>
      ) : null;
    })}
  </ul>

  <h2 style="margin-top:44px">Or start with your ballot</h2>
  <p style="color:var(--text-muted); font-size:0.94rem">
    You only vote in one of the two, and plenty of people here aren't sure
    which. <a href="/how-to-vote/">The voting page sorts that out.</a>
  </p>
  <ul class="linklist" style="margin-top:12px">
    {allRaces.map((r) => (
      <li>
        <a class="tag" href={`/candidates/#${r.key}`} style="text-decoration:none">
          {r.label} — {r.candidates.length} running, {r.seats} elected
        </a>
      </li>
    ))}
  </ul>

  <div class="notice" style="margin-top:36px">
    <p>
      <strong>I don't rate anyone.</strong> No scores, no grades, no
      endorsements, no opinion of mine about who deserves your vote. Everyone
      gets the same space, every quote is copied word for word, and when someone
      hasn't talked about a topic I say so rather than guess what they think.
      <a href="/methodology/">Here's exactly how I built it.</a>
    </p>
  </div>
</Base>
