---
import Base from "~/layouts/Base.astro";
import CandidateLine from "~/components/CandidateLine.astro";
import Quote from "~/components/Quote.astro";
import {
  flashpoints, candidates, races, seededShuffle, BUILD_SEED, type Flashpoint,
} from "~/lib/data";

export function getStaticPaths() {
  return flashpoints.map((f) => ({ params: { id: f.id }, props: { flash: f } }));
}

const { flash } = Astro.props as { flash: Flashpoint };

const hits = candidates
  .map((c) => ({
    c,
    quotes: [...c.positions, ...c.background].filter((p) => p.flashpoints.includes(flash.id)),
  }))
  .filter((h) => h.quotes.length > 0);

const grouped = races(hits.map((h) => h.c));
const quoteFor = (id: string) => hits.find((h) => h.c.id === id)!.quotes;
const totalQuotes = hits.reduce((n, h) => n + h.quotes.length, 0);
---

<Base
  title={flash.label}
  description={`Which North Vancouver candidates have talked about ${flash.label}, in their own words.`}
  shuffle
  shortlist
>
  <p style="font-size:0.88rem"><a href="/">← All issues</a></p>
  <h1>{flash.label}</h1>
  {flash.description && <p class="lede">{flash.description}</p>}

  <div class="stat-row">
    <div class="stat"><b>{hits.length}</b><span>of 59 candidates have mentioned it</span></div>
    <div class="stat"><b>{totalQuotes}</b><span>times, in what I checked</span></div>
  </div>

  {hits.length === 0 ? (
    <div class="notice"><p>Nobody has mentioned this in anything I've read.</p></div>
  ) : (
    <>
      <div class="order-note">
        <span>Listed in <span data-order-label>randomised</span> order within each race.</span>
        <button type="button" data-order-toggle hidden>Sort A–Z</button>
      </div>

      {grouped.map((race) => (
        <section>
          <div class="race-heading">
            <h2>{race.label}</h2>
            <span class="seats">{race.candidates.length} mentioned it · you elect {race.seats}</span>
          </div>
          <div class="grid" data-shuffle style="margin-top:14px">
            {seededShuffle(race.candidates, BUILD_SEED + flash.id.length).map((c) => (
              <div class="card" data-sortkey={c.surname + " " + c.name}>
                <CandidateLine candidate={c}>
                  {quoteFor(c.id).map((p) => <Quote candidate={c} position={p} />)}
                </CandidateLine>
              </div>
            ))}
          </div>
        </section>
      ))}
    </>
  )}

  <div class="notice" style="margin-top:30px">
    <p>
      This picks up candidates who used these exact words. Someone might care
      about it deeply and never name it, so read this as “who put it in
      writing”, not “who cares”.
    </p>
  </div>
</Base>
