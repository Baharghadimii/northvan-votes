---
import Base from "~/layouts/Base.astro";
import { candidates, races } from "~/lib/data";
import { isElected } from "~/lib/results";

// Minimal lookup so the page can render a list held only in the reader's browser.
const lookup = Object.fromEntries(
  candidates.map((c) => [
    c.id,
    { name: c.name, race: `${c.municipality}-${c.office}`, elected: isElected(c) },
  ]),
);
const raceMeta = Object.fromEntries(
  races().map((r) => [r.key, { label: r.label, seats: r.seats }]),
);
---

<Base
  title="Your starred candidates"
  description="The candidates you starred, grouped by race, with who was elected on October 17, 2026."
>
  <h1>Your starred candidates</h1>
  <p class="lede">
    The candidates you starred, grouped by race. The election was on October
    17, 2026, so the people who were elected are marked.{" "}
    <a href="/#results">See the official results.</a>
  </p>

  <div id="empty" class="notice">
    <p>
      You haven't starred anyone yet. Look for the ☆ beside a candidate on the
      <a href="/candidates/">candidates page</a> or any
      <a href="/">issue page</a>.
    </p>
  </div>

  <div id="ballot"></div>

  <p id="actions" hidden style="margin-top:20px; display:flex; gap:12px; flex-wrap:wrap">
    <button type="button" class="chip" id="share">Copy a link to this list</button>
    <button type="button" class="chip" id="clear">Clear the list</button>
  </p>

  <div class="notice" style="margin-top:28px">
    <p>
      <span id="shared-note" hidden><strong>You're looking at someone else's
      list.</strong> Star anyone yourself and this becomes your own.<br /></span>
      This list lives only in this browser. It's never sent anywhere, so it won't
      follow you to another device and nobody, me included, can see it.
    </p>
  </div>

  <script is:inline define:vars={{ lookup, raceMeta }}>
    (function () {
      var KEY = "nvv:shortlist";
      var order = Object.keys(raceMeta);

      function read() {
        // A ?list= in the address wins, so a shared link shows the sender's
        // picks rather than whatever the reader starred earlier.
        var shared = new URLSearchParams(location.search).get("list");
        if (shared) {
          return shared.split(",").filter(function (id) { return lookup[id]; });
        }
        try { return JSON.parse(localStorage.getItem(KEY) || "[]"); }
        catch (e) { return []; }
      }

      function shareUrl(ids) {
        return location.origin + location.pathname + "?list=" + ids.join(",");
      }

      function render() {
        var picked = read().filter(function (id) { return lookup[id]; });
        var box = document.getElementById("ballot");
        var empty = document.getElementById("empty");
        var actions = document.getElementById("actions");
        box.innerHTML = "";

        var isShared = !!new URLSearchParams(location.search).get("list");
        var note = document.getElementById("shared-note");
        if (note) note.hidden = !isShared;

        if (picked.length === 0) {
          empty.hidden = false;
          actions.hidden = true;
          return;
        }
        empty.hidden = true;
        actions.hidden = false;

        order.forEach(function (key) {
          var meta = raceMeta[key];
          var mine = picked.filter(function (id) { return lookup[id].race === key; });
          if (mine.length === 0) return;

          var sec = document.createElement("section");
          sec.className = "ballot-race card";

          var h = document.createElement("h3");
          h.textContent = meta.label;
          sec.appendChild(h);

          var note = document.createElement("p");
          note.className = "candidate-meta";
          note.style.margin = "0";
          note.textContent =
            mine.length + " starred · " +
            (meta.seats === 1 ? "1 seat" : meta.seats + " seats") + " in this race";
          sec.appendChild(note);

          var ol = document.createElement("ol");
          mine.forEach(function (id) {
            var li = document.createElement("li");
            var a = document.createElement("a");
            a.href = "/candidates/" + id + "/";
            a.textContent = lookup[id].name;
            li.appendChild(a);
            if (lookup[id].elected) {
              var tag = document.createElement("span");
              tag.className = "tag tag-elected";
              tag.style.marginLeft = "8px";
              tag.textContent = "Elected";
              li.appendChild(tag);
            }
            ol.appendChild(li);
          });
          sec.appendChild(ol);
          box.appendChild(sec);
        });
      }

      document.getElementById("share").addEventListener("click", function (e) {
        var url = shareUrl(read());
        var btn = e.currentTarget;
        function done(msg) { btn.textContent = msg; setTimeout(function () {
          btn.textContent = "Copy a link to this list"; }, 2200); }
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(function () { done("Link copied"); },
            function () { prompt("Copy this link:", url); });
        } else {
          prompt("Copy this link:", url);
        }
      });

      document.getElementById("clear").addEventListener("click", function () {
        try { localStorage.removeItem(KEY); } catch (e) {}
        render();
      });

      render();
    })();
  </script>
</Base>
