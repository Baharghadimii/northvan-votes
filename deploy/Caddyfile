# North Van Votes — static site on the VPS.
#
# Install to /etc/caddy/Caddyfile. Caddy obtains and renews TLS certificates
# automatically; there is no certbot step and no renewal cron to forget.
#
# These headers mirror site/public/_headers (which only Cloudflare Pages reads),
# so the site behaves identically whichever way it is served.

northvanvotes.ca {
	root * /var/www/northvanvotes
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}

	# Astro fingerprints these filenames, so they can never go stale. Fonts are
	# self-hosted and replaced only by a redeploy.
	@immutable path /_astro/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Photos are named by candidate id; they change only on a redeploy.
	@photos path /photos/*
	header @photos Cache-Control "public, max-age=604800"

	# Pages must revalidate. A cached voting location is the one thing this site
	# must never serve after a correction.
	@pages {
		path *.html /
		not path /_astro/* /photos/*
	}
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# Access log, so there is some idea of what gets read and where readers came
	# from. Written to stderr, which systemd captures into the journal: no log
	# file to own, and journald handles rotation. Deliberately minimal — IPs are
	# truncated by the analysis script, there are no cookies and no client-side
	# script, and nothing leaves this machine. /methodology says exactly this.
	log {
		output stderr
		format json {
			time_format iso8601
		}
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}

www.northvanvotes.ca {
	redir https://northvanvotes.ca{uri} permanent
}
